{
  "info": {
    "name": "Enterprise Service Desk API",
    "description": "Endpoints for the Enterprise Employee Service Desk & Workflow Management Portal backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000/api" },
    { "key": "token", "value": "" },
    { "key": "requestId", "value": "REQ-1024" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"employee@company.com\",\n  \"password\": \"Employee@123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "List requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/requests?status=Open&page=1&pageSize=10"
          }
        },
        {
          "name": "Create request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Laptop Access Request\",\n  \"category\": \"IT Support\",\n  \"department\": \"IT Support\",\n  \"description\": \"Need admin rights on new laptop\",\n  \"priority\": \"High\"\n}" },
            "url": "{{baseUrl}}/requests"
          }
        },
        {
          "name": "Get request by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/requests/{{requestId}}"
          }
        },
        {
          "name": "Update request",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"priority\": \"Critical\"\n}" },
            "url": "{{baseUrl}}/requests/{{requestId}}"
          }
        },
        {
          "name": "Update status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"In Progress\",\n  \"note\": \"Started work\"\n}" },
            "url": "{{baseUrl}}/requests/{{requestId}}/status"
          }
        },
        {
          "name": "Assign request",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"assignedTo\": \"U-1002\"\n}" },
            "url": "{{baseUrl}}/requests/{{requestId}}/assign"
          }
        },
        {
          "name": "Reopen request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Issue recurred\"\n}" },
            "url": "{{baseUrl}}/requests/{{requestId}}/reopen"
          }
        },
        {
          "name": "Add comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"Any update on this?\",\n  \"internal\": false\n}" },
            "url": "{{baseUrl}}/requests/{{requestId}}/comments"
          }
        }
      ]
    },
    {
      "name": "Dashboards",
      "item": [
        { "name": "Employee dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/dashboard/employee" } },
        { "name": "Manager dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/dashboard/manager" } },
        { "name": "Admin dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/dashboard/admin" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "List users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/users" } },
        { "name": "Create user", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Executive\",\n  \"email\": \"new.exec@company.com\",\n  \"role\": \"executive\",\n  \"department\": \"IT Support\",\n  \"password\": \"Temp@1234\"\n}" }, "url": "{{baseUrl}}/admin/users" } },
        { "name": "List departments", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/departments" } },
        { "name": "List categories", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/categories" } },
        { "name": "Audit logs", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/audit-logs" } }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        { "name": "List notifications", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/notifications" } },
        { "name": "Mark as read", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/notifications/N-1/read" } }
      ]
    }
  ]
}
